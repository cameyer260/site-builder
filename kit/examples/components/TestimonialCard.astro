---
interface Props {
  quote: string;
  author: string;
  role?: string;
  rating?: number;
  class?: string;
}

const { quote, author, role, rating, class: className = "" } = Astro.props;

const stars = rating ? Math.max(0, Math.min(5, Math.round(rating))) : 0;
---

<figure
  class={`group relative flex flex-col p-7 rounded-2xl bg-white border border-ink-200 shadow-(--shadow-card) hover:shadow-(--shadow-lift) hover:-translate-y-1 hover:border-brand-200 motion-safe:transition-all duration-300 overflow-hidden ${className}`}
>
  <!-- Decorative quote mark -->
  <svg
    class="absolute -top-2 -right-2 w-24 h-24 text-brand-100 group-hover:text-brand-200 motion-safe:transition-colors"
    viewBox="0 0 64 64"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M20 14c-7 0-12 5-12 12v18h16V28h-8c0-4 3-8 8-8v-6zm26 0c-7 0-12 5-12 12v18h16V28h-8c0-4 3-8 8-8v-6z"/>
  </svg>

  {stars > 0 && (
    <div class="relative flex gap-0.5 mb-5 text-accent-500" role="img" aria-label={`${stars} out of 5 stars`}>
      {Array.from({ length: 5 }).map((_, i) => (
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill={i < stars ? "currentColor" : "none"}
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          class="motion-safe:transition-transform duration-200 group-hover:scale-110"
          style={`transition-delay: ${i * 40}ms;`}
        >
          <polygon points="10,1.5 12.6,7.3 19,8.1 14.2,12.5 15.5,18.8 10,15.6 4.5,18.8 5.8,12.5 1,8.1 7.4,7.3" />
        </svg>
      ))}
    </div>
  )}
  <blockquote class="relative flex-1 text-ink-800 text-base leading-relaxed">
    &ldquo;{quote}&rdquo;
  </blockquote>
  <figcaption class="relative mt-6 pt-5 border-t border-ink-100 flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-linear-to-br from-brand-500 to-brand-700 flex items-center justify-center shrink-0 shadow-sm ring-2 ring-white">
      <span class="text-sm font-bold text-white">{author.charAt(0)}</span>
    </div>
    <div class="text-sm">
      <span class="font-semibold text-ink-900">{author}</span>
      {role && <span class="block text-ink-500 text-xs mt-0.5">{role}</span>}
    </div>
  </figcaption>
</figure>
