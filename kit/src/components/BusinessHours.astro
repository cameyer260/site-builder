---
interface HoursEntry {
  day: string;
  hours: string;
}

interface Props {
  hours: HoursEntry[];
  title?: string;
  class?: string;
}

const { hours, title = "Hours", class: className = "" } = Astro.props;
---

{/* Neutral hours list — a structured <dl>. Restyle to fit the Design Brief. */}
<div class={className}>
  <p class="mb-3 text-sm font-semibold text-ink-900">{title}</p>
  <dl class="divide-y divide-ink-100 rounded-md border border-ink-200">
    {hours.map((entry) => {
      const closed = /closed/i.test(entry.hours);
      return (
        <div class="flex items-center justify-between gap-4 px-4 py-3">
          <dt class="font-medium text-ink-900">{entry.day}</dt>
          <dd class={closed ? "text-ink-400" : "text-ink-700"}>{entry.hours}</dd>
        </div>
      );
    })}
  </dl>
</div>
