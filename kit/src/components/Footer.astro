---
import type { ImageMetadata } from "astro";

interface FooterLink {
  label: string;
  href: string;
}

interface FooterGroup {
  title: string;
  links: readonly FooterLink[];
}

interface Social {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  logoMark?: ImageMetadata;
  tagline?: string;
  phone?: string;
  email?: string;
  address?: string;
  groups?: readonly FooterGroup[];
  socials?: readonly Social[];
  class?: string;
}

const {
  siteName,
  logoMark,
  tagline,
  phone,
  email,
  address,
  groups = [],
  socials = [],
  class: className = "",
} = Astro.props;

const year = new Date().getFullYear();
const copyrightName = siteName.replace(/\.$/, "");
---

{/*
  Neutral skeleton footer. Semantic and accessible, but deliberately plain — no
  dark signature, glow, or gradients. Shared across every page for a consistent
  <footer> landmark; restyle and compose it to fit the Design Brief, the same
  way you compose the page bodies.
*/}
<footer class={`border-t border-ink-200 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex items-center gap-2">
      {logoMark && (
        <img
          src={logoMark.src}
          alt=""
          aria-hidden="true"
          width={logoMark.width}
          height={logoMark.height}
          class="h-8 w-auto"
        />
      )}
      <p class="font-semibold text-ink-900">{siteName}</p>
    </div>
    {tagline && <p class="mt-2 max-w-md text-ink-600">{tagline}</p>}

    <address class="not-italic mt-4 space-y-1 text-ink-700">
      {phone && (
        <div>
          <a href={`tel:${phone.replace(/[^\d+]/g, "")}`} class="hover:text-ink-900">{phone}</a>
        </div>
      )}
      {email && (
        <div>
          <a href={`mailto:${email}`} class="hover:text-ink-900">{email}</a>
        </div>
      )}
      {address && <div>{address}</div>}
    </address>

    {groups.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-x-12 gap-y-6">
        {groups.map((group) => (
          <div>
            <p class="font-medium text-ink-900">{group.title}</p>
            <ul class="mt-2 space-y-1">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="text-ink-700 hover:text-ink-900">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}

    {socials.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-4">
        {socials.map((s) => (
          <li>
            <a href={s.href} rel="noopener" target="_blank" class="text-ink-700 hover:text-ink-900">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-8 text-sm text-ink-500">&copy; {year} {copyrightName}. All rights reserved.</p>
  </div>
</footer>
