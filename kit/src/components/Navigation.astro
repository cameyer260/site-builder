---
import type { ImageMetadata } from "astro";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  siteName: string;
  /** Optional logo mark (the graphic symbol). siteName is always rendered as
   *  text alongside it for accessibility and SEO. */
  logoMark?: ImageMetadata;
  links: readonly NavLink[];
  ctaLabel?: string;
  ctaHref?: string;
  class?: string;
}

const { siteName, logoMark, links, ctaLabel, ctaHref, class: className = "" } = Astro.props;
---

{/*
  Neutral skeleton header. Semantic and accessible, but deliberately plain — no
  imposed look (no sticky/blur/gradient/animation/decoration). This is the
  shared header for every page, so the <header> landmark and primary nav stay
  consistent site-wide; you are expected to restyle and compose it (layout,
  responsive/mobile behavior, active states, any decoration) to fit the Design
  Brief, the same way you compose the page bodies. Relies on the browser's
  default focus outline — keep focus visible if you restyle.
*/}
<header class={className}>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center gap-x-6 gap-y-2"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-2 font-semibold text-ink-900">
      {logoMark && (
        <img
          src={logoMark.src}
          alt=""
          aria-hidden="true"
          width={logoMark.width}
          height={logoMark.height}
          class="h-8 w-auto"
        />
      )}
      <span>{siteName}</span>
    </a>

    <ul class="flex flex-wrap items-center gap-4">
      {links.map((link) => (
        <li>
          <a href={link.href} class="text-ink-700 hover:text-ink-900">{link.label}</a>
        </li>
      ))}
    </ul>

    {ctaLabel && ctaHref && (
      <a href={ctaHref} class="font-medium text-ink-900 underline underline-offset-4">
        {ctaLabel}
      </a>
    )}
  </nav>
</header>
