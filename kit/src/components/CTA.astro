---
interface Props {
  title: string;
  description?: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  class?: string;
}

const {
  title,
  description,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  class: className = "",
} = Astro.props;
---

<section class={`relative bg-mesh-brand overflow-hidden ${className}`}>
  <!-- Animated blobs -->
  <div
    class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-brand-500/40 blur-3xl pointer-events-none motion-safe:animate-blob"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-accent-500/25 blur-3xl pointer-events-none motion-safe:animate-blob"
    style="animation-delay: -6s;"
    aria-hidden="true"
  ></div>

  <div class="absolute inset-0 bg-dot-grid opacity-[0.06] text-white pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/15 text-xs font-semibold uppercase tracking-widest text-white/80 mb-6" data-reveal>
      <span class="w-1.5 h-1.5 rounded-full bg-accent-400 motion-safe:animate-pulse"></span>
      Get started
    </div>
    <h2
      class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight tracking-tight"
      data-reveal
    >
      {title}
    </h2>
    {description && (
      <p
        class="mt-5 text-lg text-white/75 max-w-2xl mx-auto leading-relaxed"
        data-reveal
        data-reveal-delay="100"
      >
        {description}
      </p>
    )}
    {(primaryCtaLabel || secondaryCtaLabel) && (
      <div
        class="mt-10 flex flex-col sm:flex-row gap-3 justify-center"
        data-reveal
        data-reveal-delay="200"
      >
        {primaryCtaLabel && primaryCtaHref && (
          <a
            href={primaryCtaHref}
            class="group relative inline-flex items-center justify-center gap-2 h-12 px-8 rounded-button bg-white text-brand-700 font-semibold shadow-xl hover:shadow-2xl hover:-translate-y-0.5 motion-safe:transition-all duration-200 overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-700 focus-visible:ring-white"
          >
            <span
              class="absolute inset-0 -translate-x-full group-hover:translate-x-full motion-safe:transition-transform duration-700 bg-linear-to-r from-transparent via-brand-100/60 to-transparent"
              aria-hidden="true"
            ></span>
            <span class="relative">{primaryCtaLabel}</span>
            <svg
              class="relative w-4 h-4 motion-safe:transition-transform duration-200 group-hover:translate-x-1"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 8h12M9 3l5 5-5 5"/>
            </svg>
          </a>
        )}
        {secondaryCtaLabel && secondaryCtaHref && (
          <a
            href={secondaryCtaHref}
            class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-button bg-white/10 backdrop-blur-sm text-white border border-white/30 font-semibold hover:bg-white/20 hover:border-white/50 hover:-translate-y-0.5 motion-safe:transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"
          >
            {secondaryCtaLabel}
          </a>
        )}
      </div>
    )}
  </div>
</section>
