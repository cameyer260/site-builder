---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  primaryCtaLabel,
  primaryCtaHref,
  secondaryCtaLabel,
  secondaryCtaHref,
  class: className = "",
} = Astro.props;
---

<section class={`relative bg-mesh-brand overflow-hidden ${className}`}>
  <!-- Animated decorative blobs (sit over the dark mesh — keep them vibrant) -->
  <div
    class="absolute -top-32 -right-32 w-[560px] h-[560px] rounded-full bg-brand-500/40 blur-3xl pointer-events-none motion-safe:animate-blob"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-40 -left-32 w-[520px] h-[520px] rounded-full bg-accent-500/15 blur-3xl pointer-events-none motion-safe:animate-blob"
    style="animation-delay: -5s;"
    aria-hidden="true"
  ></div>
  <div
    class="absolute top-1/2 left-1/3 w-72 h-72 rounded-full bg-brand-400/25 blur-3xl pointer-events-none motion-safe:animate-blob"
    style="animation-delay: -9s;"
    aria-hidden="true"
  ></div>

  <!-- Faint dot grid wash, tuned for dark bg -->
  <div class="absolute inset-0 bg-dot-grid opacity-[0.08] text-white pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        {eyebrow && (
          <p class="inline-flex items-center gap-2 pl-2 pr-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-semibold uppercase tracking-widest text-white/90 mb-6 shadow-sm motion-safe:animate-fade-down">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full rounded-full bg-brand-300 opacity-75 motion-safe:animate-ping"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-300"></span>
            </span>
            {eyebrow}
          </p>
        )}
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-[1.05] tracking-tight motion-safe:animate-fade-up"
          style="animation-delay: 80ms;"
        >
          {title}
        </h1>
        {subtitle && (
          <p
            class="mt-6 text-lg sm:text-xl text-white/75 max-w-xl leading-relaxed motion-safe:animate-fade-up"
            style="animation-delay: 200ms;"
          >
            {subtitle}
          </p>
        )}
        {(primaryCtaLabel || secondaryCtaLabel) && (
          <div
            class="mt-10 flex flex-col sm:flex-row gap-3 motion-safe:animate-fade-up"
            style="animation-delay: 320ms;"
          >
            {primaryCtaLabel && primaryCtaHref && (
              <a
                href={primaryCtaHref}
                class="group relative inline-flex items-center justify-center gap-2 h-12 px-7 rounded-button bg-white text-brand-800 font-semibold text-base shadow-xl hover:shadow-2xl hover:-translate-y-0.5 active:translate-y-0 motion-safe:transition-all duration-200 overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-900 focus-visible:ring-white"
              >
                <span
                  class="absolute inset-0 -translate-x-full group-hover:translate-x-full motion-safe:transition-transform duration-700 ease-out bg-linear-to-r from-transparent via-brand-100/60 to-transparent"
                  aria-hidden="true"
                ></span>
                <span class="relative">{primaryCtaLabel}</span>
                <svg
                  class="relative w-4 h-4 motion-safe:transition-transform duration-200 group-hover:translate-x-1"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M2 8h12M9 3l5 5-5 5"/>
                </svg>
              </a>
            )}
            {secondaryCtaLabel && secondaryCtaHref && (
              <a
                href={secondaryCtaHref}
                class="inline-flex items-center justify-center gap-2 h-12 px-7 rounded-button bg-white/10 backdrop-blur-md text-white border border-white/25 font-semibold text-base hover:bg-white/20 hover:border-white/40 hover:-translate-y-0.5 motion-safe:transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-brand-900 focus-visible:ring-white"
              >
                {secondaryCtaLabel}
              </a>
            )}
          </div>
        )}
      </div>

      <div
        class="relative motion-safe:animate-scale-in"
        style="animation-delay: 240ms;"
      >
        <!-- Soft glow behind hero image -->
        <div
          class="absolute -inset-4 bg-linear-to-tr from-brand-500/40 via-accent-500/25 to-brand-400/40 rounded-3xl blur-2xl opacity-80 motion-safe:animate-pulse-glow pointer-events-none"
          aria-hidden="true"
        ></div>
        <div class="relative motion-safe:animate-float-slow">
          <slot name="visual">
            <!-- Placeholder — replace by passing <img slot="visual" ...> or similar -->
            <div class="aspect-4/3 rounded-2xl shadow-xl overflow-hidden bg-linear-to-br from-brand-600 to-brand-900 relative">
              <svg class="absolute inset-0 w-full h-full" viewBox="0 0 480 360" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="440" cy="-20" r="200" fill="white" fill-opacity="0.05"/>
                <circle cx="40" cy="360" r="160" fill="white" fill-opacity="0.04"/>
                <circle cx="240" cy="180" r="260" fill="white" fill-opacity="0.02"/>
                <rect x="40" y="60" width="180" height="120" rx="12" fill="white" fill-opacity="0.08"/>
                <rect x="240" y="90" width="200" height="10" rx="5" fill="white" fill-opacity="0.15"/>
                <rect x="240" y="114" width="160" height="8" rx="4" fill="white" fill-opacity="0.10"/>
                <rect x="240" y="134" width="130" height="8" rx="4" fill="white" fill-opacity="0.07"/>
                <rect x="40" y="210" width="400" height="80" rx="10" fill="white" fill-opacity="0.05"/>
                <rect x="40" y="310" width="190" height="30" rx="8" fill="white" fill-opacity="0.12"/>
                <rect x="250" y="310" width="190" height="30" rx="8" fill="white" fill-opacity="0.06"/>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-white">
                <div class="w-16 h-16 rounded-2xl bg-white/10 flex items-center justify-center mb-4 ring-1 ring-white/20">
                  <svg class="w-8 h-8 text-white/60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
                  </svg>
                </div>
                <p class="text-sm font-medium text-white/50">Hero image</p>
                <p class="text-xs text-white/30 mt-1">slot name="visual"</p>
              </div>
            </div>
          </slot>
        </div>

        <!-- Floating accent chip -->
        <div
          class="hidden sm:flex absolute -bottom-4 -left-4 lg:-left-6 items-center gap-3 px-4 py-3 rounded-2xl bg-white shadow-xl border border-ink-100 motion-safe:animate-float-medium"
          aria-hidden="true"
          style="animation-delay: -2s;"
        >
          <div class="w-9 h-9 rounded-full bg-brand-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div class="text-xs">
            <p class="font-semibold text-ink-900">Trusted locally</p>
            <p class="text-ink-500">Licensed &amp; insured</p>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>
