---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

{/*
  Accessible FAQ accordion: native <details>/<summary> (keyboard + screen-reader
  + no-JS toggle) with a JS height animation that honors prefers-reduced-motion.
  The behavior and a11y are the functional floor — keep the data-faq /
  data-faq-panel hooks, the `is-open` class, and the script. The styling is
  deliberately neutral; restyle to fit the Design Brief.
*/}
<div data-faq class={`space-y-3 ${className}`}>
  {items.map((item) => (
    <details class="group overflow-hidden rounded-lg border border-ink-200">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ink-400">
        <span class="font-medium text-ink-900">{item.question}</span>
        <span
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink-200 text-ink-600 motion-safe:transition-transform duration-300 group-[.is-open]:rotate-45"
          aria-hidden="true"
        >
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="6" y1="1" x2="6" y2="11"></line>
            <line x1="1" y1="6" x2="11" y2="6"></line>
          </svg>
        </span>
      </summary>
      <div data-faq-panel class="overflow-hidden">
        <p class="border-t border-ink-100 px-5 pb-4 pt-4 text-ink-600 leading-relaxed">{item.answer}</p>
      </div>
    </details>
  ))}
</div>

<script>
  // Reliable open/close animation for the FAQ <details> elements.
  //
  // The native CSS approaches (animating grid-template-rows or
  // ::details-content) are inconsistent across browsers because a closed
  // <details> doesn't render its content, so there's no "from" frame to
  // interpolate. Instead we keep the native <details> semantics (keyboard,
  // screen readers, no-JS toggle) and animate the element's height with the
  // Web Animations API on toggle — which works the same everywhere.
  //
  // The open-state visuals (icon rotation) are driven by an `is-open` class
  // rather than the native [open] attribute. That lets them ease back to the
  // closed look at the *start* of the collapse — while [open] must stay set
  // until the height animation ends so the content is still rendered — keeping
  // the open and close transitions perfectly symmetric.
  //
  // Respects prefers-reduced-motion: when "reduce" is set we don't intercept
  // the click, so the browser performs its normal instant toggle.
  const DURATION = 300;

  function setupAccordion(details: HTMLDetailsElement) {
    const summary = details.querySelector<HTMLElement>("summary");
    const panel = details.querySelector<HTMLElement>("[data-faq-panel]");
    if (!summary || !panel) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let animation: Animation | null = null;
    let state: "idle" | "expanding" | "shrinking" = "idle";

    // Keep `is-open` in sync with the real state for native/reduced-motion
    // toggles and the end of each animation.
    details.addEventListener("toggle", () => {
      details.classList.toggle("is-open", details.open);
    });

    const animateTo = (from: number, to: number, finalOpen: boolean) => {
      animation?.cancel();
      animation = details.animate(
        { height: [`${from}px`, `${to}px`] },
        { duration: DURATION, easing: "ease-out" },
      );
      animation.onfinish = () => {
        details.open = finalOpen;
        details.style.height = "";
        details.style.overflow = "";
        animation = null;
        state = "idle";
      };
      animation.oncancel = () => {
        state = "idle";
      };
    };

    const expand = () => {
      state = "expanding";
      animateTo(details.offsetHeight, summary.offsetHeight + panel.offsetHeight, true);
    };

    const shrink = () => {
      state = "shrinking";
      // Drop the open look now so the icon eases out with the collapse,
      // even though [open] stays set until the animation finishes.
      details.classList.remove("is-open");
      animateTo(details.offsetHeight, summary.offsetHeight, false);
    };

    summary.addEventListener("click", (event) => {
      // Honor reduced-motion (and let modifier-clicks behave normally).
      if (reduce.matches) return;
      event.preventDefault();
      details.style.overflow = "hidden";
      if (state === "shrinking" || !details.open) {
        // Lock current height, reveal content so it can be measured, then grow.
        details.style.height = `${details.offsetHeight}px`;
        details.open = true;
        requestAnimationFrame(expand);
      } else if (state === "expanding" || details.open) {
        shrink();
      }
    });
  }

  function initFaq() {
    document
      .querySelectorAll<HTMLDetailsElement>("[data-faq] details")
      .forEach(setupAccordion);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFaq);
  } else {
    initFaq();
  }
</script>
