---
/*
 * Plain HTML form. No `action` attribute is set — wire one up per client:
 *   - Formspree:  action="https://formspree.io/f/xxxx" method="POST"
 *   - mailto:     action="mailto:you@example.com"
 *   - Pages Fn:   action="/api/contact" method="POST"
 */
interface Props {
  action?: string;
  method?: "GET" | "POST";
  submitLabel?: string;
  showPhoneField?: boolean;
  messageLabel?: string;
  messagePlaceholder?: string;
  class?: string;
}

const {
  action,
  method = "POST",
  submitLabel = "Send Message",
  showPhoneField = true,
  messageLabel = "How can we help?",
  messagePlaceholder = "Tell us a bit about your project or question…",
  class: className = "",
} = Astro.props;

const fieldClass =
  "w-full rounded-md border border-ink-300 bg-white px-3 py-2 text-ink-900 placeholder:text-ink-400 focus:border-ink-500 focus:outline-none focus:ring-2 focus:ring-ink-400";
---

{/*
  Neutral, accessible contact form. Labels, required fields, autocomplete, and
  visible focus states are the functional floor — keep them. The styling is
  deliberately plain; restyle to fit the Design Brief.
*/}
<form {...(action ? { action, method } : {})} class={`space-y-5 ${className}`}>
  <p class="text-sm text-ink-500">Fields marked * are required.</p>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1.5 block text-sm font-medium text-ink-900">Name *</span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        placeholder="Jane Smith"
        class={fieldClass}
      />
    </label>
    <label class="block">
      <span class="mb-1.5 block text-sm font-medium text-ink-900">Email *</span>
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="jane@example.com"
        class={fieldClass}
      />
    </label>
  </div>

  {showPhoneField && (
    <label class="block">
      <span class="mb-1.5 block text-sm font-medium text-ink-900">
        Phone <span class="font-normal text-ink-400">(optional)</span>
      </span>
      <input type="tel" name="phone" autocomplete="tel" placeholder="(555) 000-0000" class={fieldClass} />
    </label>
  )}

  {Astro.slots.has("fields") && <slot name="fields" />}

  <label class="block">
    <span class="mb-1.5 block text-sm font-medium text-ink-900">{messageLabel} *</span>
    <textarea
      name="message"
      rows="5"
      required
      placeholder={messagePlaceholder}
      class={`${fieldClass} resize-none`}
    ></textarea>
  </label>

  <button
    type="submit"
    class="inline-flex h-11 items-center justify-center rounded-button bg-brand-600 px-6 font-semibold text-white hover:bg-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand-500"
  >
    {submitLabel}
  </button>
</form>
