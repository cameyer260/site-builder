---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
---
<BaseLayout>
  {/* Skeleton page. Compose this from the Kit's primitives (and/or your own new
      components) to realize the Design Brief. Do not ship this
      placeholder. */}
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <h1 class="text-4xl font-bold tracking-tight text-ink-900">{site.name}</h1>
    <p class="mt-4 text-lg text-ink-600">
      Replace this skeleton with a homepage composition that fits the Design Brief.
    </p>
  </section>
</BaseLayout>
