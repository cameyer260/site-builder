{
  "name": "site-builder",
  "version": "0.0.0",
  "description": "Generates working prototype websites for prospective freelance clients.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "sb": "./bin/sb.ts"
  },
  "scripts": {
    "sb": "bun run bin/sb.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "engine:smoke": "bun run scripts/engine-smoke.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "mammoth": "^1.12.0",
    "node-html-markdown": "^2.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.60.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "docx": "^9.7.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^6.0.3"
  }
}
